---
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';
import { getDictionary } from '../i18n/dictionaries';
import { defaultLocale } from '../i18n/config';
import { getPath } from '../i18n/routes';

const t = getDictionary(defaultLocale);
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.notFound.title} · {t.meta.siteName}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="container" style="padding-block: 6rem; text-align: center;">
      <h1>{t.notFound.title}</h1>
      <p style="color: var(--color-text-muted); max-width: 28rem; margin-inline: auto;">
        {t.notFound.body}
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn btn--primary" href={getPath(defaultLocale, 'home')}>{t.notFound.cta}</a>
      </p>
      <p style="margin-top: 1.5rem;">
        <a href="/sr/">Srpski</a>
        ·
        <a href="/en/">English</a>
        ·
        <a href="/sl/">Slovenščina</a>
      </p>
    </main>
  </body>
</html>
