---
interface Props {
  label: string;
  variant?: 'icon' | 'button';
}

const { label, variant = 'icon' } = Astro.props;
const href = 'https://www.instagram.com/filipoviicdanica/';
---

<a
  class:list={['ig', { 'ig--button': variant === 'button' }]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={variant === 'icon' ? label : undefined}
>
  <svg class="ig__icon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
    <path
      fill="currentColor"
      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
    ></path>
  </svg>
  {variant === 'button' && <span>{label}</span>}
</a>

<style>
  .ig {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
  }

  .ig:hover {
    text-decoration: none;
    background: rgba(241, 238, 231, 0.12);
  }

  .ig:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ig__icon {
    flex-shrink: 0;
  }

  .ig--button {
    width: auto;
    height: auto;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    gap: 0.6rem;
    border-width: 2px;
    border-radius: var(--radius-sm);
    border-color: var(--color-forest);
    color: var(--color-forest);
    font-weight: 600;
    background: transparent;
  }

  .ig--button:hover {
    background: var(--color-forest);
    color: var(--color-white);
  }
</style>
