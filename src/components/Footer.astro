---
import type { Locale } from '../i18n/config';
import { getPath } from '../i18n/routes';
import { getDictionary } from '../i18n/dictionaries';
import { locales, localeLabels } from '../i18n/config';
import InstagramLink from './InstagramLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const nav = [
  { href: getPath(locale, 'home'), label: t.nav.home },
  { href: getPath(locale, 'about'), label: t.nav.about },
  { href: getPath(locale, 'services'), label: t.nav.services },
  { href: getPath(locale, 'contact'), label: t.nav.contact },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">{t.meta.siteName}</p>
      <p class="footer__tagline">{t.footer.tagline}</p>
      <div class="footer__social">
        <InstagramLink label={t.footer.instagram} />
      </div>
    </div>
    <div>
      <p class="footer__heading">{t.footer.navigation}</p>
      <ul class="footer__list">
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="footer__heading">{t.footer.legal}</p>
      <ul class="footer__list">
        <li>
          <a href={getPath(locale, 'privacy')}>{t.footer.privacy}</a>
        </li>
        {
          locales.map((loc) => (
            <li>
              <a href={getPath(loc, 'home')}>{localeLabels[loc]}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {t.meta.siteName}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-forest);
    color: rgba(241, 238, 231, 0.85);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  .footer__brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-ivory);
    margin-bottom: var(--space-3);
  }

  .footer__tagline {
    max-width: 28rem;
    margin: 0;
  }

  .footer__social {
    margin-top: var(--space-4);
  }

  .footer__heading {
    font-weight: 600;
    color: var(--color-ivory);
    margin-bottom: var(--space-3);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer a {
    color: rgba(241, 238, 231, 0.85);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-ivory);
    text-decoration: underline;
  }

  .footer__bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(241, 238, 231, 0.15);
    font-size: 0.9rem;
  }

  .footer__bottom p {
    margin: 0;
  }
</style>
